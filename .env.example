# Placeholders only. Real values go in .env locally and in Netlify's environment settings.
# Everything with a VITE_ prefix is bundled into the public site: only put public values here.
# NEVER put a Supabase service-role key in this project.

# Supabase (anon key is public by design; Row Level Security is what protects the data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site address, e.g. https://johnsonpedia.com (used for sitemap, canonical and share tags)
VITE_SITE_URL=

# Public contact details. Leave blank until confirmed; blank means nothing is shown.
VITE_CONTACT_EMAIL=
VITE_LINKEDIN_URL=
# Defaults to https://github.com/Babarinde1 when blank
VITE_GITHUB_URL=
VITE_HUGGINGFACE_URL=
